+async function resolveProductionEvidenceTarget(env, object) {
+  const meta=object?.customMetadata||{};
+  const parsed=parseProductionEvidenceKey(object?.key);
+  let submissionId=Number(meta.submissionId||0)||Number(parsed?.submissionId||0);
+  let sub=null;
+  if(submissionId>0){
+    sub=await env.DB.prepare(`SELECT id,work_plan_item_id,employee_code,work_date,brand,store_code,status FROM field_submissions WHERE id=? LIMIT 1`).bind(submissionId).first();
+  }
+
+  let matchMode=sub?"submission-id":"";
+  if(!sub){
+    const employeeCode=String(meta.employeeCode||"").trim();
+    const storeCode=String(meta.storeCode||"").trim();
+    const workDate=String(meta.workDate||"").trim();
+    if(employeeCode&&storeCode&&workDate){
+      const {results:candidates}=await env.DB.prepare(`
+        SELECT id,work_plan_item_id,employee_code,work_date,brand,store_code,status
+        FROM field_submissions
+        WHERE employee_code=? AND store_code=? AND work_date=?
+          AND status IN ('EVIDENCE_PENDING','SUBMITTED','RETURNED')
+        ORDER BY id DESC LIMIT 3
+      `).bind(employeeCode,storeCode,workDate).all();
+      if((candidates||[]).length===1){
+        sub=candidates[0];
+        submissionId=Number(sub.id);
+        matchMode="unique-metadata";
+      }else if((candidates||[]).length>1){
+        return {ok:false,reason:"AMBIGUOUS_SUBMISSION",candidateCount:candidates.length};
+      }
+    }
+  }
+  if(!sub)return {ok:false,reason:"SUBMISSION_NOT_FOUND"};
+
+  const keyMatch=String(object?.key||"").match(/\/(bill|store)\/(\d+)-/i);
+  const kind=String(meta.evidenceKind||parsed?.kind||(keyMatch?.[1]?.toLowerCase()==="bill"?"R":keyMatch?.[1]?"S":"")).toUpperCase();
+  const slotRaw=meta.evidenceSlot ?? parsed?.slot ?? (keyMatch?Math.max(0,Number(keyMatch[2])-1):NaN);
+  const slot=Number(slotRaw);
+  if(!["R","S"].includes(kind)||!Number.isInteger(slot)||slot<0||slot>=(kind==="R"?3:10)){
+    return {ok:false,reason:"EVIDENCE_SLOT_OR_KIND_INVALID",submissionId:Number(sub.id)};
+  }
+  return {ok:true,sub,submissionId:Number(sub.id),kind,slot,matchMode};
