+async function linkProductionEvidenceObject(env, object, forcedSubmissionId=0) {
+  let resolved=await resolveProductionEvidenceTarget(env,object);
+  if(forcedSubmissionId>0){
+    const forced=await env.DB.prepare(`SELECT id,work_plan_item_id,employee_code,work_date,brand,store_code,status FROM field_submissions WHERE id=? LIMIT 1`).bind(forcedSubmissionId).first();
+    if(!forced)return {linked:false,reason:"SUBMISSION_NOT_FOUND"};
+    const meta=object?.customMetadata||{},parsed=parseProductionEvidenceKey(object?.key),keyMatch=String(object?.key||"").match(/\/(bill|store)\/(\d+)-/i);
+    const kind=String(meta.evidenceKind||parsed?.kind||(keyMatch?.[1]?.toLowerCase()==="bill"?"R":keyMatch?.[1]?"S":"")).toUpperCase();
+    const slot=Number(meta.evidenceSlot ?? parsed?.slot ?? (keyMatch?Math.max(0,Number(keyMatch[2])-1):NaN));
+    if(!["R","S"].includes(kind)||!Number.isInteger(slot)||slot<0||slot>=(kind==="R"?3:10))return {linked:false,reason:"EVIDENCE_SLOT_OR_KIND_INVALID"};
+    resolved={ok:true,sub:forced,submissionId:Number(forced.id),kind,slot,matchMode:"forced-submission"};
+  }
+  if(!resolved.ok)return {linked:false,...resolved};
+
+  const {sub,submissionId,kind,slot}=resolved;
+  const contentType=object.httpMetadata?.contentType||null;
+  const existing=await env.DB.prepare(`SELECT id,object_key FROM field_submission_evidence WHERE submission_id=? AND kind=? AND slot=? LIMIT 1`).bind(submissionId,kind,slot).first();
+
+  if(existing?.object_key===object.key){
